# Copy this file to .env and change what you need. Every line is optional.

# Language model served by Ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
# Context window in tokens (llama3.1 supports up to 131072). 32768 fits on a 12 GB GPU.
LLM_CONTEXT=32768

# Embeddings: "huggingface" (local sentence-transformers model, GPU if available)
# or "ollama" (no PyTorch needed: run `ollama pull bge-m3` first)
EMBEDDING_PROVIDER=huggingface
# EMBEDDING_MODEL=intfloat/multilingual-e5-large

# Retrieval and memory
# TOP_K=6
# HISTORY_MESSAGES=20

# LangSmith tracing (optional): tracing is on only when a key is set
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=youtube-rag-balade-mentale
